{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "NestJS API",
  "description": "Configuration contract for a NestJS HTTP API.",
  "required": ["NODE_ENV", "PORT"],
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "enum": ["development", "test", "production"]
    },
    "PORT": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "DB_POOL_SIZE": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "SHOW_SWAGGER": {
      "type": "boolean",
      "default": false
    },
    "PRIVATE_API_KEY": {
      "type": "string",
      "x-envdoctor-secret": true
    }
  }
}