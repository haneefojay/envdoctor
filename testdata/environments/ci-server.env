# Raw process-environment entries as reported by the host, in CI.
# Unknown entries (PATH, HOME, CI, ...) are expected to surface as warnings.
PATH=/usr/local/bin:/usr/bin:/bin
HOME=/home/ci
CI=true
GITHUB_ACTIONS=true
GITHUB_SHA=abc123def456
HTTP_PORT=3000
HOST=127.0.0.1
CACHE_URL=redis://redis:6379/0
REQUEST_TIMEOUT_MS=150
RETRY_COUNT=5
DEBUG_LOGGING=false
SUPPORT_EMAIL=ops@example.com
EXTRA_DEPLOY_ENV=staging