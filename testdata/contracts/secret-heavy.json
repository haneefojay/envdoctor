{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Secret-heavy backend",
  "description": "Configuration contract for a service that consumes many credentials.",
  "required": ["DB_PASSWORD", "API_SECRET"],
  "properties": {
    "DB_PASSWORD": {
      "type": "string",
      "minLength": 8,
      "x-envdoctor-secret": true
    },
    "API_SECRET": {
      "type": "string",
      "minLength": 16,
      "x-envdoctor-secret": true
    },
    "S3_ACCESS_KEY": {
      "type": "string",
      "x-envdoctor-secret": true
    },
    "SMTP_PASSWORD": {
      "type": "string",
      "x-envdoctor-secret": true
    },
    "STRIPE_SECRET_KEY": {
      "type": "string",
      "x-envdoctor-secret": true
    },
    "LOG_LEVEL": {
      "type": "string",
      "enum": ["error", "warn", "info", "debug"],
      "default": "info"
    }
  }
}